APP_ENV=dev
APP_DEBUG=1
APP_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
DATABASE_URL="sqlite:///%kernel.project_dir%/data/ezscore_v1.sqlite"

EZ_ANALYSIS_URL="http://127.0.0.1:8502"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email — Resend API transport.
# Create the key in Resend, verify the sending domain, then configure
# the real values only in .env.local (never commit secrets).
MAILER_DSN="resend+api://re_CHANGE_ME@default"
MAILER_FROM="activation@example.com"

# Cloudflare Turnstile - public contact form
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
