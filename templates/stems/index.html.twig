{% extends 'base.html.twig' %}
{% block title %}StemsLab — {{ song.title }} — EZScore_v1{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/workflow-tabs-r23-2.css?v=20260926r31">
<link rel="stylesheet" href="/assets/css/catalog.css?v=20260925r23_2">
<link rel="stylesheet" href="/assets/css/stems.css?v=20260929r39_2a">
{% endblock %}

{% block body %}
{% include 'layout/song/_workflow_tabs.html.twig' with {current:'stems', song:song} %}

<header class="page-head stems-head">
    <div>
        <div class="eyebrow">{{ 'stems.eyebrow'|trans({}, 'stems') }}</div>
        <h1>{{ 'stems.title'|trans({'%title%': song.title}, 'stems') }}</h1>
        <p class="page-note">{{ 'stems.scope'|trans({}, 'stems') }}</p>
    </div>
    <a href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">Répertoire</a>
</header>

<section class="panel stems-source">
    <div>
        <strong>{{ song.title }}</strong>
        <span>{{ song.artist }}</span>
        <small>{{ song.audioOriginalName ?: '—' }}</small>
    </div>
    <div class="stem-source-meta">
        <span>SHA-256</span>
        <code>{{ song.audioSha256 ? song.audioSha256|slice(0, 16) ~ '…' : '—' }}</code>
    </div>
</section>

<section class="panel stems-action-panel">
    {% if latest_job %}
        <div class="stem-job-state">
            <span class="stem-job-badge state-{{ latest_job.status.value }}" data-stem-job-status>{{ ('stems.job.' ~ latest_job.status.value)|trans({}, 'stems') }}</span>
            <small>#{{ latest_job.id }} · {{ latest_job.updatedAt|date('d/m/Y H:i:s') }}</small>
        </div>
    {% endif %}

    {% if job_active %}
        {% set pct = progress.percent|default(latest_job ? latest_job.progress : 0) %}
        {% set is_queued = latest_job and latest_job.status.value == 'queued' %}

        <div class="stem-progress"
             data-stem-progress
             data-stem-status-url="{{ path('app_song_stems_log', {'_locale': app.request.locale, id: song.id}) }}">
            <div class="stem-progress-head">
                <strong data-stem-progress-message>
                    {% if is_queued %}
                        {{ 'stems.progress.queued'|trans({}, 'stems') }}
                    {% else %}
                        {{ progress.message|default('stems.processing'|trans({}, 'stems')) }}
                    {% endif %}
                </strong>
                {% if not is_queued %}
                    <span data-stem-progress-percent>{{ pct }} %</span>
                {% else %}
                    <span data-stem-progress-percent hidden></span>
                {% endif %}
            </div>

            {% if is_queued %}
                <div class="stem-progress-indeterminate" data-stem-progress-wait aria-label="En attente"></div>
            {% else %}
                <progress max="100" value="{{ pct }}" data-stem-progress-bar></progress>
            {% endif %}

            <div class="stem-progress-meta" data-stem-progress-meta>
                {% if progress.stage|default(null) %}<small>{{ progress.stage }}</small>{% endif %}
                {% if progress.engine_percent is defined and progress.engine_percent is not null %}
                    <small>Moteur : {{ progress.engine_percent }} %</small>
                {% endif %}
                {% if progress.elapsed_seconds is defined %}
                    <small>Temps étape : {{ progress.elapsed_seconds|number_format(1, ',', ' ') }} s</small>
                {% endif %}
                {% if progress.updated_at|default(null) %}
                    <small>Activité : {{ progress.updated_at|date('H:i:s') }}</small>
                {% endif %}
            </div>
        </div>

        <p class="page-note" data-stem-progress-note>
            {{ 'stems.progress.running_note'|trans({}, 'stems') }}
        </p>
    {% elseif stems_complete %}
        <div class="stem-ready">
            <strong>{{ 'stems.ready'|trans({}, 'stems') }}</strong>
            {% if manifest.generated_at|default(null) %}
                <span>{{ manifest.generated_at|date('d/m/Y H:i:s') }}</span>
            {% endif %}
            {% if manifest.duration_seconds|default(null) %}
                <small>{{ 'stems.duration'|trans({'%seconds%': manifest.duration_seconds}, 'stems') }}</small>
            {% endif %}
        </div>

        <form method="post"
              action="{{ path('app_song_stems_generate', {'_locale': app.request.locale, id: song.id}) }}"
              data-stem-reanalyze-form>
            <input type="hidden" name="_token" value="{{ csrf_token('song_stems_generate_' ~ song.id) }}">
            <input type="hidden" name="force" value="1">
            <button type="submit">{{ 'stems.reanalyze'|trans({}, 'stems') }}</button>
        </form>
    {% else %}
        <p>{{ 'stems.not_generated'|trans({}, 'stems') }}</p>

        {% if latest_job and latest_job.status.value == 'failed' %}
            <div class="stem-error">
                <strong>{{ 'stems.failed'|trans({}, 'stems') }}</strong>
                <code>{{ latest_job.errorCode }}</code>
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_song_stems_generate', {'_locale': app.request.locale, id: song.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('song_stems_generate_' ~ song.id) }}">
            <button class="primary" type="submit">{{ 'stems.generate'|trans({}, 'stems') }}</button>
        </form>
    {% endif %}
</section>

{% if stems_complete %}
<div class="stem-modal-backdrop" data-stem-reanalyze-modal hidden>
    <section class="stem-modal" role="dialog" aria-modal="true" aria-labelledby="stem-reanalyze-title" aria-describedby="stem-reanalyze-description">
        <div class="stem-modal-icon" aria-hidden="true">↻</div>
        <div class="stem-modal-content">
            <div class="eyebrow">{{ 'stems.reanalyze_modal.eyebrow'|trans({}, 'stems') }}</div>
            <h2 id="stem-reanalyze-title">{{ 'stems.reanalyze_modal.title'|trans({}, 'stems') }}</h2>
            <p id="stem-reanalyze-description">
                {{ 'stems.reanalyze_modal.body'|trans({}, 'stems') }}
            </p>
        </div>
        <div class="stem-modal-actions">
            <button type="button" class="stem-modal-cancel" data-stem-reanalyze-cancel>{{ 'stems.reanalyze_modal.cancel'|trans({}, 'stems') }}</button>
            <button type="button" class="primary" data-stem-reanalyze-confirm>{{ 'stems.reanalyze_modal.confirm'|trans({}, 'stems') }}</button>
        </div>
    </section>
</div>

{% if not playback_ready %}
<section class="panel stem-playback-prep">
    <div>
        <div class="eyebrow">{{ 'stems.playback.eyebrow'|trans({}, 'stems') }}</div>
        <h2>{{ 'stems.playback.title'|trans({}, 'stems') }}</h2>
        <p class="page-note">{{ 'stems.playback.description'|trans({}, 'stems') }}</p>
    </div>

    <form method="post"
          action="{{ path('app_song_stems_playback_build', {'_locale': app.request.locale, id: song.id}) }}">
        <input type="hidden"
               name="_token"
               value="{{ csrf_token('song_stems_playback_build_' ~ song.id) }}">
        <button type="submit" class="primary">
            {{ 'stems.playback.build'|trans({}, 'stems') }}
        </button>
    </form>
</section>
{% else %}
<section class="panel stem-mixer-panel"
         data-stem-mixer
         data-song-id="{{ song.id }}"
         data-mix-save-url="{{ path('app_song_stems_mix', {'_locale': app.request.locale, id: song.id}) }}"
         data-mix-token="{{ csrf_token('song_stems_mix_' ~ song.id) }}"
         data-mix-settings="{{ stem_mix_settings|json_encode|e('html_attr') }}"
         data-i18n-saved="{{ 'stems.mixer.saved'|trans({}, 'stems') }}"
         data-i18n-modified="{{ 'stems.mixer.modified'|trans({}, 'stems') }}"
         data-i18n-saving="{{ 'stems.mixer.saving'|trans({}, 'stems') }}"
         data-i18n-save-failed="{{ 'stems.mixer.save_failed'|trans({}, 'stems') }}"
         data-i18n-web-audio-unavailable="{{ 'stems.mixer.web_audio_unavailable'|trans({}, 'stems') }}"
         data-i18n-ready="{{ 'stems.mixer.ready'|trans({}, 'stems') }}"
         data-i18n-playing="{{ 'stems.mixer.playing'|trans({}, 'stems') }}"
         data-i18n-paused="{{ 'stems.mixer.paused'|trans({}, 'stems') }}"
         data-i18n-finished="{{ 'stems.mixer.finished'|trans({}, 'stems') }}"
         data-i18n-loading-template="{{ 'stems.mixer.loading_progress'|trans({'%done%':'__DONE__','%total%':'__TOTAL__'}, 'stems') }}"
         data-i18n-loaded-partial-template="{{ 'stems.mixer.loaded_partial'|trans({'%done%':'__DONE__','%total%':'__TOTAL__'}, 'stems') }}"
         data-i18n-audio-error-template="{{ 'stems.mixer.audio_error'|trans({'%error%':'__ERROR__'}, 'stems') }}">
    <div class="stems-section-head">
        <div>
            <div class="eyebrow">{{ 'stems.mixer.eyebrow'|trans({}, 'stems') }}</div>
            <h2>{{ 'stems.mixer.title'|trans({}, 'stems') }}</h2>
            <p class="page-note">
                {{ 'stems.mixer.description'|trans({}, 'stems') }}
            </p>
        </div>
        <span class="stem-mixer-state" data-mixer-state>{{ 'stems.mixer.loading'|trans({}, 'stems') }}</span>
    </div>

    <div class="stem-mixer-grid stem-mixer-head" aria-hidden="true">
        <span>{{ 'stems.mixer.track'|trans({}, 'stems') }}</span><span>{{ 'stems.mixer.enabled'|trans({}, 'stems') }}</span><span>{{ 'stems.mixer.volume'|trans({}, 'stems') }}</span>
    </div>

    <div class="stem-mixer-tracks">
        {% set mix_tracks = [
            {'key':'original', 'label':('stems.mixer.original'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'original'}), 'enabled':1, 'volume':1.00},
            {'key':'lead_vocals', 'label':('stems.name.lead_vocals'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'lead_vocals'}), 'enabled':0, 'volume':0.82},
            {'key':'backing_vocals', 'label':('stems.name.backing_vocals'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'backing_vocals'}), 'enabled':0, 'volume':0.72},
            {'key':'drums', 'label':('stems.name.drums'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'drums'}), 'enabled':0, 'volume':0.72},
            {'key':'bass', 'label':('stems.name.bass'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'bass'}), 'enabled':0, 'volume':0.72},
            {'key':'guitar', 'label':('stems.name.guitar'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'guitar'}), 'enabled':0, 'volume':0.72},
            {'key':'piano', 'label':('stems.name.piano'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'piano'}), 'enabled':0, 'volume':0.72},
            {'key':'other', 'label':('stems.name.other'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'other'}), 'enabled':0, 'volume':0.72}
        ] %}

        {% for track in mix_tracks %}
            <div class="stem-mixer-grid stem-mixer-row"
                 data-mixer-track
                 data-track-key="{{ track.key }}"
                 data-track-url="{{ track.url }}"
                 data-default-enabled="{{ track.enabled }}"
                 data-default-volume="{{ track.volume }}">
                <div class="stem-track-title">
                    <strong>{{ track.label }}</strong>
                    <span class="stem-track-loader" data-track-loader hidden aria-hidden="true"></span>
                    <small class="stem-track-load-status" data-track-load-status></small>
                </div>
                <label class="stem-mixer-toggle">
                    <input type="checkbox" data-track-enabled {{ track.enabled ? 'checked' : '' }}>
                    <span>{{ 'stems.mixer.active'|trans({}, 'stems') }}</span>
                </label>
                <label class="stem-mixer-slider">
                    <input type="range" min="0" max="1.25" step="0.01" value="{{ track.volume }}" data-track-volume>
                    <output data-track-volume-output>{{ (track.volume * 100)|round }}%</output>
                </label>
            </div>
        {% endfor %}
    </div>

    <section class="stem-master-fx">
    <div class="stem-master-fx-head">
        <div>
            <div class="eyebrow">{{ 'stems.mixer.master_fx'|trans({}, 'stems') }}</div>
            <strong>{{ 'stems.mixer.master'|trans({}, 'stems') }}</strong>
        </div>
        <div class="stem-master-fx-status">
            <span class="stem-limiter-badge">{{ 'stems.mixer.limiter'|trans({}, 'stems') }}</span>
            <span class="stem-mix-save-state" data-mix-save-state>{{ 'stems.mixer.saved'|trans({}, 'stems') }}</span>
        </div>
    </div>
    <div class="stem-master-fx-grid">
        <label class="stem-master-control"><span>{{ 'stems.mixer.low'|trans({}, 'stems') }}</span><input type="range" min="-12" max="12" step="0.5" value="0" data-master-low><output data-master-low-output>0 dB</output></label>
        <label class="stem-master-control"><span>{{ 'stems.mixer.mid'|trans({}, 'stems') }}</span><input type="range" min="-12" max="12" step="0.5" value="0" data-master-mid><output data-master-mid-output>0 dB</output></label>
        <label class="stem-master-control"><span>{{ 'stems.mixer.high'|trans({}, 'stems') }}</span><input type="range" min="-12" max="12" step="0.5" value="0" data-master-high><output data-master-high-output>0 dB</output></label>
        <label class="stem-master-control"><span>{{ 'stems.mixer.compression'|trans({}, 'stems') }}</span><input type="range" min="0" max="100" step="1" value="0" data-master-compression><output data-master-compression-output>0%</output></label>
        <label class="stem-master-control"><span>{{ 'stems.mixer.master'|trans({}, 'stems') }}</span><input type="range" min="0" max="1.25" step="0.01" value="1" data-master-volume><output data-master-volume-output>100%</output></label>
        <button type="button" class="stem-master-reset" data-master-fx-reset>{{ 'stems.mixer.reset_master_fx'|trans({}, 'stems') }}</button>
    </div>
</section>
<div class="stem-transport">
        <input class="stem-seek" type="range" min="0" max="1000" value="0" step="1" data-mixer-seek aria-label="{{ 'stems.mixer.position'|trans({}, 'stems') }}">
        <div class="stem-transport-controls">
            <button type="button" data-mixer-play>{{ 'stems.mixer.play'|trans({}, 'stems') }}</button>
            <button type="button" data-mixer-pause>{{ 'stems.mixer.pause'|trans({}, 'stems') }}</button>
            <button type="button" data-mixer-stop>{{ 'stems.mixer.stop'|trans({}, 'stems') }}</button>
            <label class="stem-speed-control">
                <span>{{ 'stems.mixer.speed'|trans({}, 'stems') }}</span>
                <select data-mixer-rate>
                    <option value="0.75">0,75×</option>
                    <option value="0.9">0,90×</option>
                    <option value="1" selected>1,00×</option>
                    <option value="1.1">1,10×</option>
                    <option value="1.25">1,25×</option>
                </select>
            </label>
            <span class="stem-time" data-mixer-time>0:00 / 0:00</span>
        </div>
    </div>
</section>

{% endif %}

<section class="panel stem-technical">
    <div class="eyebrow">{{ 'stems.technical'|trans({}, 'stems') }}</div>
    <div class="stem-tech-grid">
        <div><span>{{ 'stems.engine_instruments'|trans({}, 'stems') }}</span><strong>{{ manifest.engines.instrumental.engine|default('—') }}</strong><small>{{ manifest.engines.instrumental.model|default('') }}</small></div>
        <div><span>{{ 'stems.engine_vocals'|trans({}, 'stems') }}</span><strong>{{ manifest.engines.vocal_split.engine|default('—') }}</strong><small>{{ manifest.engines.vocal_split.model|default('') }}</small></div>
        <div><span>{{ 'stems.timebase'|trans({}, 'stems') }}</span><strong>{{ manifest.timebase|default('—') }}</strong></div>
    </div>
</section>
{% endif %}
{% endblock %}

{% block javascripts %}
<script src="/assets/js/stems-progress.js?v=20260926r24_10"></script>
{% if stems_complete and playback_ready %}
<script src="/assets/js/stems-mixer.js?v=20260929r39_2a"></script>
{% endif %}
{% endblock %}
