{% extends 'base.html.twig' %}
{% block title %}{{ event.title }} — EZScore_v1{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/events.css?v=20260925r20">
<link rel="stylesheet" href="/assets/css/entity-picker.css?v=20260925r20">
<link rel="stylesheet" href="/assets/css/collection-filters.css?v=20260925r20">
<link rel="stylesheet" href="/assets/css/events/session-delete-confirm-r1.css?v=20261002r1">
{% endblock %}
{% block body %}
{% set share_url = url('app_event_show', {'_locale': app.request.locale, id: event.id}) %}
{% set share_text = event.title ~ ' — ' ~ event.startsAt|date('d/m/Y H:i') ~ ' — ' ~ share_url %}

<header class="page-head">
  <div>
    <div class="eyebrow">{{ 'event.eyebrow'|trans({}, 'event') }}</div>
    <h1>{{ event.title }}</h1>
    <p class="page-note">{{ event.startsAt|date('d/m/Y H:i') }}</p>
  </div>
</header>

<section class="panel">
  <div class="event-summary-grid">
    <div><span>{{ 'event.fields.group'|trans({}, 'event') }}</span><strong>{{ event.group ? event.group.name : '—' }}</strong></div>
    <div>
      <span>{{ 'event.fields.playlist'|trans({}, 'event') }}</span>
      <strong>
        {% if event.playlist %}
          <a href="{{ path('app_event_session_playlist', {'_locale': app.request.locale, id: event.id}) }}">{{ event.playlist.name }}</a>
        {% else %}
          —
        {% endif %}
      </strong>
    </div>
    <div><span>{{ 'event.fields.location'|trans({}, 'event') }}</span><strong>{{ event.location ?: '—' }}</strong></div>
    <div><span>{{ 'event.fields.status'|trans({}, 'event') }}</span><strong>{{ ('event.status.' ~ event.status.value)|trans({}, 'event') }}</strong></div>
    <div><span>{{ 'event.fields.creator'|trans({}, 'event') }}</span><strong>{{ event.createdBy.displayName }}</strong></div>
  </div>

  {% if event.description %}<p class="event-description-view">{{ event.description }}</p>{% endif %}

  <div class="event-share-actions">
    <a class="primary" href="https://wa.me/?text={{ share_text|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
    <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url|url_encode }}" target="_blank" rel="noopener">Facebook</a>
    <a href="https://twitter.com/intent/tweet?text={{ event.title|url_encode }}&url={{ share_url|url_encode }}" target="_blank" rel="noopener">X</a>
  </div>
</section>

{% if event.createdBy.id == app.user.id %}
<section class="panel">
  <h2>Test projection</h2>
  <p class="page-note">Ouvre un LiveRun de test sans envoyer d'invitation.</p>
  <div class="collection-actions">
    {% if event.playlist %}
      <a class="primary" href="{{ path('app_event_session_playlist', {'_locale': app.request.locale, id: event.id}) }}">
        Ouvrir la session
      </a>
    {% endif %}
    <form method="post" action="{{ path('app_live_test_start', {id: event.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('live_test_start_' ~ event.id) }}">
      <button class="primary" type="submit">Tester la session</button>
    </form>
    <form method="post" action="{{ path('app_live_test_stop', {id: event.id}) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('live_test_stop_' ~ event.id) }}">
      <button type="submit">Arrêter le test</button>
    </form>
  </div>
</section>
{% endif %}

{% if event.createdBy.id == app.user.id and event.status.value == 'draft' %}
<section class="panel">
  <h2>{{ 'event.validate_title'|trans({}, 'event') }}</h2>
  <p class="page-note">{{ 'event.validate_note'|trans({}, 'event') }}</p>
  <form method="post" action="{{ path('app_event_validate', {'_locale': app.request.locale, id: event.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('event_validate_' ~ event.id) }}">
    <button class="primary" type="submit">{{ 'event.validate_button'|trans({}, 'event') }}</button>
  </form>
</section>
{% endif %}

{% if is_granted('EVENT_MANAGE', event) %}
<section class="panel">
  <h2>{{ 'event.edit'|trans({}, 'event') }}</h2>
  <form method="post" action="{{ path('app_event_update', {'_locale': app.request.locale, id: event.id}) }}" class="event-form">
    <input type="hidden" name="_token" value="{{ csrf_token('event_update_' ~ event.id) }}">
    <label>{{ 'event.fields.title'|trans({}, 'event') }}<input name="title" value="{{ event.title }}" required></label>
    <label>{{ 'event.fields.starts_at'|trans({}, 'event') }}<input type="datetime-local" name="starts_at" value="{{ event.startsAt|date('Y-m-d\\TH:i') }}" required></label>
    <label>{{ 'event.fields.ends_at'|trans({}, 'event') }}<input type="datetime-local" name="ends_at" value="{{ event.endsAt ? event.endsAt|date('Y-m-d\\TH:i') : '' }}"></label>
    <label>{{ 'event.fields.location'|trans({}, 'event') }}<input name="location" value="{{ event.location }}"></label>
    <label>{{ 'event.fields.status'|trans({}, 'event') }}
      <select name="status">
        {% for status in ['draft','validated','scheduled','cancelled','completed'] %}<option value="{{ status }}" {{ event.status.value == status ? 'selected' : '' }}>{{ ('event.status.' ~ status)|trans({}, 'event') }}</option>{% endfor %}
      </select>
    </label>
    <label class="event-description">{{ 'event.fields.description'|trans({}, 'event') }}<textarea name="description" rows="3">{{ event.description }}</textarea></label>
    <button class="primary" type="submit">{{ 'event.save'|trans({}, 'event') }}</button>
  </form>

  <div class="collection-actions">
    <button type="button"
            data-entity-picker
            data-picker-mode="single"
            data-picker-title="{{ 'event.assign_group'|trans({}, 'event') }}"
            data-picker-url="{{ path('app_event_picker_groups', {'_locale': app.request.locale, event_id: event.id}) }}"
            data-picker-submit-url="{{ path('app_event_set_group', {'_locale': app.request.locale, id: event.id}) }}"
            data-picker-csrf="{{ csrf_token('event_group_' ~ event.id) }}">
      {{ 'event.assign_group'|trans({}, 'event') }}
    </button>

    <button type="button"
            data-entity-picker
            data-picker-mode="single"
            data-picker-title="{{ 'event.assign_playlist'|trans({}, 'event') }}"
            data-picker-url="{{ path('app_event_picker_playlists', {'_locale': app.request.locale, event_id: event.id}) }}"
            data-picker-submit-url="{{ path('app_event_set_playlist', {'_locale': app.request.locale, id: event.id}) }}"
            data-picker-csrf="{{ csrf_token('event_playlist_' ~ event.id) }}">
      {{ 'event.assign_playlist'|trans({}, 'event') }}
    </button>
  </div>
</section>
{% endif %}

<section class="panel">
  <h2>{{ 'event.participants'|trans({}, 'event') }} <small class="list-filter-chip">{{ participant_pager.total }}</small></h2>

  <form method="get" action="{{ path('app_event_show', {'_locale': app.request.locale, id: event.id}) }}" class="list-filter-panel">
    <div class="list-filter-row compact">
      <label class="list-filter-field"><span>{{ 'list_filters.search'|trans({}, 'list_filters') }}</span><input type="search" name="pq" value="{{ participant_filters.q }}" placeholder="{{ 'list_filters.participant_search'|trans({}, 'list_filters') }}"></label>
      <label class="list-filter-field"><span>{{ 'list_filters.rsvp'|trans({}, 'list_filters') }}</span>
        <select name="pstatus">
          <option value="">{{ 'list_filters.all'|trans({}, 'list_filters') }}</option>
          {% for status in ['invited','accepted','declined','maybe'] %}<option value="{{ status }}" {{ participant_filters.status == status ? 'selected' : '' }}>{{ ('event.rsvp.' ~ status)|trans({}, 'event') }}</option>{% endfor %}
        </select>
      </label>
      <div class="list-filter-actions">
        <button class="primary" type="submit">{{ 'list_filters.filter'|trans({}, 'list_filters') }}</button>
        <a class="list-filter-clear" href="{{ path('app_event_show', {'_locale': app.request.locale, id: event.id}) }}">{{ 'list_filters.clear'|trans({}, 'list_filters') }}</a>
      </div>
    </div>
  </form>

  {% set participant_common = {'_locale': app.request.locale, id: event.id, pq: participant_filters.q ?: null, pstatus: participant_filters.status ?: null} %}
  <nav class="list-alphabet" aria-label="{{ 'list_filters.alphabet'|trans({}, 'list_filters') }}">
    <a class="{{ participant_filters.letter is null ? 'active' : '' }}" href="{{ path('app_event_show', participant_common) }}">{{ 'list_filters.all'|trans({}, 'list_filters') }}</a>
    {% for alpha in alphabet %}<a class="{{ participant_filters.letter == alpha ? 'active' : '' }}" href="{{ path('app_event_show', participant_common|merge({pletter: alpha})) }}">{{ alpha }}</a>{% endfor %}
  </nav>

  <div class="event-participant-list">
    {% for participant in participants %}
      <div class="event-participant-row">
        <strong>{{ participant.user.displayName }}</strong>
        <span>{{ ('event.rsvp.' ~ participant.status.value)|trans({}, 'event') }}</span>
        <small>{{ participant.emailNotifiedAt ? ('event.email_sent'|trans({}, 'event')) : '' }}</small>
      </div>
    {% else %}
      <div class="empty">{{ 'event.no_participants'|trans({}, 'event') }}</div>
    {% endfor %}
  </div>

  {% if participant_pager.pages > 1 %}
  <nav class="list-pagination">
    {% set pc = participant_common|merge({pletter: participant_filters.letter}) %}
    {% if participant_pager.page > 1 %}<a href="{{ path('app_event_show', pc|merge({ppage: participant_pager.page - 1})) }}">←</a>{% else %}<span class="disabled">←</span>{% endif %}
    {% for p in 1..participant_pager.pages %}
      {% if p == 1 or p == participant_pager.pages or (p >= participant_pager.page - 2 and p <= participant_pager.page + 2) %}
        <a class="{{ p == participant_pager.page ? 'current' : '' }}" href="{{ path('app_event_show', pc|merge({ppage: p})) }}">{{ p }}</a>
      {% elseif p == 2 or p == participant_pager.pages - 1 %}<span>…</span>{% endif %}
    {% endfor %}
    {% if participant_pager.page < participant_pager.pages %}<a href="{{ path('app_event_show', pc|merge({ppage: participant_pager.page + 1})) }}">→</a>{% else %}<span class="disabled">→</span>{% endif %}
  </nav>
  {% endif %}

  {% if is_granted('EVENT_INVITE', event) %}
  <div class="collection-actions">
    <button type="button"
            data-entity-picker
            data-picker-title="{{ 'event.add_participants'|trans({}, 'event') }}"
            data-picker-url="{{ path('app_event_picker_users', {'_locale': app.request.locale, event_id: event.id, membership: 'out'}) }}"
            data-picker-submit-url="{{ path('app_event_participants_bulk_add', {'_locale': app.request.locale, id: event.id}) }}"
            data-picker-csrf="{{ csrf_token('event_participants_' ~ event.id) }}">
      {{ 'event.add_participants'|trans({}, 'event') }}
    </button>
    <button type="button"
            data-entity-picker
            data-picker-title="{{ 'event.remove_participants'|trans({}, 'event') }}"
            data-picker-url="{{ path('app_event_picker_users', {'_locale': app.request.locale, event_id: event.id, membership: 'in'}) }}"
            data-picker-submit-url="{{ path('app_event_participants_bulk_remove', {'_locale': app.request.locale, id: event.id}) }}"
            data-picker-csrf="{{ csrf_token('event_participants_' ~ event.id) }}">
      {{ 'event.remove_participants'|trans({}, 'event') }}
    </button>
  </div>
  {% endif %}
</section>

{% if my_participation %}
<section class="panel">
  <h2>{{ 'event.my_response'|trans({}, 'event') }}</h2>
  <form method="post" action="{{ path('app_event_rsvp', {'_locale': app.request.locale, id: event.id}) }}" class="event-rsvp-actions">
    <input type="hidden" name="_token" value="{{ csrf_token('event_rsvp_' ~ event.id) }}">
    <button name="status" value="accepted" class="primary">{{ 'event.rsvp.accepted'|trans({}, 'event') }}</button>
    <button name="status" value="maybe">{{ 'event.rsvp.maybe'|trans({}, 'event') }}</button>
    <button name="status" value="declined">{{ 'event.rsvp.declined'|trans({}, 'event') }}</button>
  </form>
</section>
{% endif %}

{% if is_granted('EVENT_MANAGE', event) %}
<div class="session-delete-actions">
  <button type="button" class="session-delete-danger" data-session-delete-open>
    {{ 'event.delete'|trans({}, 'event') }}
  </button>
</div>

<dialog class="session-delete-dialog" data-session-delete-dialog>
  <div class="session-delete-dialog__body">
    <h2>{{ 'event.delete'|trans({}, 'event') }}</h2>
    <p>{{ 'event.delete_confirm'|trans({}, 'event') }}</p>
    <div class="session-delete-dialog__buttons">
      <button type="button" data-session-delete-cancel>{{ 'event.delete_cancel'|trans({}, 'event') }}</button>
      <form method="post" action="{{ path('app_event_delete', {'_locale': app.request.locale, id: event.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('event_delete_' ~ event.id) }}">
        <button class="primary session-delete-danger" type="submit">{{ 'event.delete_confirm_button'|trans({}, 'event') }}</button>
      </form>
    </div>
  </div>
</dialog>
{% endif %}

{% include 'components/_entity_picker_modal.html.twig' %}
{% endblock %}
{% block javascripts %}<script src="/assets/js/entity-picker.js?v=20260925r20"></script><script src="/assets/js/events/session-delete-confirm-r1.js?v=20261002r1"></script>{% endblock %}
