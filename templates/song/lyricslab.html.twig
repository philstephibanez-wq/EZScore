{% extends 'base.html.twig' %}

{% block title %}LyricsLab — {{ song.title }} — EZScore_v1{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/workflow-tabs-r23-2.css?v=20260926r31">
<link rel="stylesheet" href="/assets/css/stems.css?v=20260929r39_2a">
<link rel="stylesheet" href="/assets/css/chordslab.css?v=20260928r35_10">
<link rel="stylesheet" href="/assets/css/lyricslab-r37.css?v=20260929r39_2">
<link rel="stylesheet" href="/assets/css/lyrics-ovh-r38-16.css?v=20260929r38_16h">
<link rel="stylesheet" href="/assets/css/lyrics-history-r38-15.css?v=20260929r38_16b">
<link rel="stylesheet" href="/assets/css/lyrics-dirty-guard-r38-16j.css?v=20260929r38_16j">
<link rel="stylesheet" href="/assets/css/components/ezscore-live-visual-settings.css?v=20260930r39_2d">
{% endblock %}

{% block body %}
{% include 'layout/song/_workflow_tabs.html.twig' with {current:'lyrics', song:song} %}

<header class="page-head chordslab-head">
    <div>
        <div class="eyebrow">LyricsLab</div>
        <h1>LyricsLab — {{ song.title }}</h1>
        <p class="page-note">Timeline ChordsLab conservée : accords au-dessus, paroles ancrées exactement sur les beats.</p>
    </div>
    <a href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">Répertoire</a>
</header>

{% include 'song/components/_lab_song_card.html.twig' with {song:song, beat_events:beat_events} %}

{% include 'song/components/_live_visual_settings.html.twig' with {
    song:song,
    context:'lyrics'
} %}

<section class="panel chordslab-settings lyricslab-source-panel">
    <div class="chordslab-prompter-head">
        <div>
            <div class="eyebrow">Paroles source</div>
            <h2>Texte éditable</h2>
        </div>

        <div class="chordslab-prompter-actions lyricslab-actions">
            <div class="lyrics-ovh-toolbar"
                 data-lyrics-ovh
                 data-search-url="{{ path('app_song_lyrics_ovh_search', {'_locale': app.request.locale, id: song.id}) }}"
                 data-autocomplete-url="{{ path('app_song_lyrics_ovh_autocomplete', {'_locale': app.request.locale, id: song.id}) }}"
                 data-import-url="{{ path('app_song_lyrics_ovh_import', {'_locale': app.request.locale, id: song.id}) }}"
                 data-token="{{ csrf_token('song_lyrics_ovh_' ~ song.id) }}">
                <input type="search"
                       data-lyrics-ovh-query
                       value="{{ (song.artist ~ ' ' ~ song.title)|trim }}"
                       maxlength="180"
                       autocomplete="off"
                       placeholder="Titre ou artiste">
                <div class="lyrics-ovh-autocomplete" data-lyrics-ovh-autocomplete hidden></div>
                <button type="button" data-lyrics-ovh-search>Chercher les paroles</button>
            </div>

            <form method="post"
                  action="{{ path('app_song_lyricslab_extract', {'_locale': app.request.locale, id: song.id}) }}"
                  {% if song.lyricsSourceText %}
                  data-ez-confirm="Extraire automatiquement les paroles ? Le texte actuel de la box sera remplacé par la proposition Whisper."
                  {% endif %}>
                <input type="hidden" name="_token" value="{{ csrf_token('song_lyricslab_extract_' ~ song.id) }}">
                <button type="submit">Extraire les paroles</button>
            </form>

            <form method="post"
                  action="{{ path('app_song_lyricslab_analyze', {'_locale': app.request.locale, id: song.id}) }}"
                  id="lyrics-analyze-form">
                <input type="hidden" name="_token" value="{{ csrf_token('song_lyricslab_analyze_' ~ song.id) }}">
                <button type="submit" class="primary">Analyser les paroles</button>
            </form>
        </div>
    </div>

        <div class="lyrics-ovh-output" data-lyrics-ovh-output>
        <div class="lyrics-ovh-status" data-lyrics-ovh-status></div>
        <div class="lyrics-ovh-results" data-lyrics-ovh-results></div>
    </div>

<textarea data-lyrics-source
              name="lyrics_source"
              form="lyrics-analyze-form"
              rows="10"
              spellcheck="true"
              placeholder="Collez ici les paroles exactes, ou utilisez « Extraire les paroles »…">{{ song.lyricsSourceText }}</textarea>

    <div class="lyrics-history-shell" data-lyrics-history
         data-list-url="{{ path('app_song_lyrics_history', {'_locale': app.request.locale, id: song.id}) }}"
         data-save-url="{{ path('app_song_lyrics_history_save', {'_locale': app.request.locale, id: song.id}) }}"
         data-restore-url-template="{{ path('app_song_lyrics_history_restore', {'_locale': app.request.locale, id: song.id, revisionId:999999})|replace({'999999':'__REVISION__'}) }}"
         data-delete-url-template="{{ path('app_song_lyrics_history_delete', {'_locale': app.request.locale, id: song.id, revisionId:999999})|replace({'999999':'__REVISION__'}) }}"
         data-token="{{ csrf_token('song_lyrics_history_' ~ song.id) }}">

        <div class="lyrics-history-savebar">
            <form class="lyrics-history-editor" data-lyrics-history-save>
                <label>
                    Source
                    <select name="lyrics_history_source_type">
                        <option value="manual">Manuel</option>
                        <option value="lyrics_ovh">Lyrics.ovh</option>
                        <option value="whisper">Whisper</option>
                        <option value="other">Autre</option>
                    </select>
                </label>
                <label>
                    Commentaire personnel
                    <input type="text"
                           name="lyrics_history_comment"
                           maxlength="1000"
                           placeholder="Ex. : paroles cherchées avec OVH">
                </label>
                <button type="submit">Sauvegarder cette version</button>
            </form>
            <div class="lyrics-manual-state" data-lyrics-manual-state>Sauvegardé</div>
            <div class="lyrics-history-feedback" data-lyrics-history-feedback></div>
        </div>

        <details class="lyrics-history">
            <summary>Historique des paroles (<span data-lyrics-history-count>0</span>)</summary>
            <div class="lyrics-history-list" data-lyrics-history-list>
                <p class="page-note">Chargement de l’historique…</p>
            </div>
        </details>
    </div>
<div class="lyricslab-source-footer">
        <p class="page-note">
            Les sauts de ligne restent des métadonnées éditoriales pour l’impression / futur karaoké vertical.
            Ils ne décalent jamais la timeline horizontale.
        </p>
</div>

    

    <div class="chord-analysis-progress"
         data-lyrics-progress
         data-status-url="{{ path('app_song_lyricslab_status', {'_locale': app.request.locale, id: song.id}) }}"
         hidden>
        <div class="chord-analysis-progress-head">
            <span data-lyrics-progress-text>Paroles…</span>
            <strong data-lyrics-progress-percent>0%</strong>
        </div>
        <progress max="100" value="0"></progress>
    </div>
</section>

<section class="panel chordslab-prompter"
         data-lyricslab
         data-song-id="{{ song.id }}"
         data-beats="{{ beat_events|json_encode|e('html_attr') }}"
         data-chords="{{ chord_events|json_encode|e('html_attr') }}"
         data-lyrics="{{ lyric_events|json_encode|e('html_attr') }}"
         data-capo="{{ song.capo }}"
         data-time-signature="{{ song.timeSignature }}"
         data-profile-data-url-template="{{ path('app_song_chordslab_profile_data', {'_locale': app.request.locale, id: song.id, profile:'__PROFILE__'}) }}"
         data-profile-save-url="{{ path('app_song_chordslab_profile', {'_locale': app.request.locale, id: song.id}) }}"
         data-profile-token="{{ csrf_token('song_chordslab_profile_' ~ song.id) }}"
         data-edit-url-template="{{ path('app_song_lyricslab_word', {'_locale': app.request.locale, id: song.id, eventId:999999})|replace({'999999':'__EVENT__'}) }}"
         data-edit-token="{{ csrf_token('song_lyricslab_word_' ~ song.id) }}"
         data-chord-beat-edit-url-template="{{ path('app_song_chordslab_beat_override', {'_locale': app.request.locale, id: song.id, beatId: 999999})|replace({'999999':'__BEAT__'}) }}"
         data-chord-edit-token="{{ csrf_token('song_chordslab_edit_' ~ song.id) }}">
    <div class="chordslab-prompter-head">
        <div>
            <div class="eyebrow">Prompteur</div>
            <h2>Timeline harmonique + paroles</h2>
        </div>
        <div class="chord-profile-status">
            <span>Profil affiché</span>
            <strong>{{ ('chordslab.level.' ~ song.chordAnalysisLevel)|trans({}, 'chordslab') }}</strong>
            <select class="lyrics-profile-select" data-lyrics-profile aria-label="Profil d’accords">
                <option value="beginner" {% if song.chordAnalysisLevel == 'beginner' %}selected{% endif %}>Débutant</option>
                <option value="intermediate" {% if song.chordAnalysisLevel == 'intermediate' %}selected{% endif %}>Intermédiaire</option>
                <option value="expert" {% if song.chordAnalysisLevel == 'expert' %}selected{% endif %}>Expert</option>
            </select>
            <small>{{ lyric_events|length }} mots · rendu syllabique</small>
        </div>
    </div>

    {% include 'song/components/_timeline_stage.html.twig' with {
        mode: 'lyrics',
        show_diagram: false
    } %}

    <p class="page-note chordslab-edit-help">
        Timeline musicale commune : cliquez un accord pour le modifier ; syllabes et accords partagent exactement le même axe temporel.
    </p>
</section>

{% include 'song/components/_analysis_player.html.twig' with {
    song: song,
    stem_mix_settings: stem_mix_settings,
    playback_ready: playback_ready
} %}
{% endblock %}

{% block javascripts %}
<script src="/assets/js/lab-song-card.js?v=20260928r38_8"></script>
<script src="/assets/js/audio/ezscore-audio-engine.js?v=20260928r35_10"></script>
<script src="/assets/js/stems-mixer.js?v=20260929r39_2a"></script>
<script src="/assets/js/ezscore-timeline-core-r39.js?v=20260929r39_0"></script>
<script src="/assets/js/components/ezscore-live-visual-settings.js?v=20260930r39_2d"></script>
<script src="/assets/js/lyricslab-timeline-r39.js?v=20260929r39_0_1"></script>
<script src="/assets/js/lyricslab-r37.js?v=20260929r39_0"></script>
<script src="/assets/js/lyricslab-r38-6-fix.js?v=20260928r38_6"></script>
<script src="/assets/js/lyrics-history-r38-15.js?v=20260929r38_16j"></script>
<script src="/assets/js/lyrics-ovh-r38-16.js?v=20260929r38_16i"></script>
<script src="/assets/js/lyrics-dirty-guard-r38-16j.js?v=20260929r38_16m2"></script>
<script src="/assets/js/lyricslab-collision-r39-2.js?v=20260929r39_2"></script>
{% endblock %}
