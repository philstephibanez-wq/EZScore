{% extends 'base.html.twig' %}

{% block title %}ChordsLab — {{ song.title }} — EZScore_v1{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/workflow-tabs-r23-2.css?v=20260926r31">
<link rel="stylesheet" href="/assets/css/stems.css?v=20260929r39_2a">
<link rel="stylesheet" href="/assets/css/chordslab.css?v=20260928r35_8a">
<link rel="stylesheet" href="/assets/css/components/ezscore-live-visual-settings.css?v=20260930r39_2d">
{% endblock %}

{% block body %}
{% include 'layout/song/_workflow_tabs.html.twig' with {current:'chords', song:song} %}

<header class="page-head chordslab-head">
    <div>
        <div class="eyebrow">ChordsLab</div>
        <h1>ChordsLab — {{ song.title }}</h1>
        <p class="page-note">{{ 'chordslab.lead'|trans({}, 'chordslab') }}</p>
    </div>
    <a href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">Répertoire</a>
</header>

{% include 'song/components/_lab_song_card.html.twig' with {song:song, beat_events:beat_events} %}

{% include 'song/components/_live_visual_settings.html.twig' with {
    song:song,
    time_signatures:time_signatures,
    context:'chords'
} %}

<section class="panel chordslab-prompter"
         data-chordslab
         data-events="{{ chord_events|json_encode|e('html_attr') }}"
         data-profiles="{{ chord_profiles|json_encode|e('html_attr') }}"
         data-profile="{{ chord_profile }}"
         data-profile-url="{{ path('app_song_chordslab_profile', {'_locale': app.request.locale, id: song.id}) }}"
         data-profile-token="{{ csrf_token('song_chordslab_profile_' ~ song.id) }}"
         data-profile-data-url-template="{{ path('app_song_chordslab_profile_data', {'_locale': app.request.locale, id: song.id, profile:'__PROFILE__'}) }}"
         data-beats="{{ beat_events|json_encode|e('html_attr') }}"
         data-capo="{{ song.capo }}"
         data-time-signature="{{ song.timeSignature }}"
         data-edit-url-template="{{ path('app_song_chordslab_event', {'_locale': app.request.locale, id: song.id, eventId: 999999})|replace({'999999':'__EVENT__'}) }}"
         data-beat-edit-url-template="{{ path('app_song_chordslab_beat_override', {'_locale': app.request.locale, id: song.id, beatId: 999999})|replace({'999999':'__BEAT__'}) }}"
         data-edit-token="{{ csrf_token('song_chordslab_edit_' ~ song.id) }}">
    <div class="chordslab-prompter-head">
        <div>
            <div class="eyebrow">{{ 'chordslab.prompter'|trans({}, 'chordslab') }}</div>
            <h2>{{ 'chordslab.timeline'|trans({}, 'chordslab') }}</h2>
        </div>

        <div class="chord-profile-status">
            <span>Profil affiché</span>
            <strong data-chord-profile-badge>{{ ('chordslab.level.' ~ chord_profile)|trans({}, 'chordslab') }}</strong>
            <small data-chord-profile-count>{{ chord_events|length }} accords</small>
        </div>

        <div class="chordslab-prompter-actions">
            <form method="post"
                  action="{{ path('app_song_chordslab_analyze', {'_locale': app.request.locale, id: song.id}) }}"
                  data-chord-analyze-form>
                <input type="hidden" name="_token" value="{{ csrf_token('song_chordslab_analyze_' ~ song.id) }}">
                <label class="chord-analysis-noise-filter">
                    <input type="checkbox" name="filter_noise" value="1" data-noise-filter
                           data-save-url="{{ path('app_song_chordslab_noise_filter', {'_locale': app.request.locale, id: song.id}) }}"
                           data-save-token="{{ csrf_token('song_chordslab_noise_filter_' ~ song.id) }}"
                           {{ song.chordNoiseFilterEnabled ? 'checked' : '' }}>
                    <span>Filtrer applaudissements / foule pour l’analyse</span>
                </label>
                <button type="submit" class="primary">{{ (chord_events ? 'chordslab.analyze.again' : 'chordslab.analyze.button')|trans({}, 'chordslab') }}</button>
            </form>
            
    <div class="chord-analysis-progress"
         data-chord-analysis-progress
         data-status-url="{{ path('app_song_chordslab_status', {'_locale': app.request.locale, id: song.id}) }}"
         hidden>
        <div class="chord-analysis-progress-head">
            <span data-chord-analysis-text>Analyse harmonique…</span>
            <strong data-chord-analysis-percent>0%</strong>
        </div>
        <progress max="100" value="0"></progress>
    </div>

    {% if has_chord_overrides %}
            <form method="post"
                  action="{{ path('app_song_chordslab_reset', {'_locale': app.request.locale, id: song.id}) }}"
                  data-ez-confirm="Réinitialiser les accords ? Les corrections manuelles seront supprimées et les accords issus de la dernière analyse seront restaurés.">
                <input type="hidden" name="_token" value="{{ csrf_token('song_chordslab_reset_' ~ song.id) }}">
                <button type="submit">{{ 'chordslab.reset.button'|trans({}, 'chordslab') }}</button>
            </form>
            {% endif %}
        </div>
    </div>

    {% if chord_events %}
        <div class="chordslab-stage">
            <div class="chord-diagram" data-chord-diagram hidden></div>
            <div class="chordslab-measures" data-chordslab-measures></div>
        </div>
        <p class="page-note chordslab-edit-help">{{ 'chordslab.edit_help'|trans({}, 'chordslab') }}</p>
    {% else %}
        <div class="chordslab-empty">
            <strong>{{ 'chordslab.no_timeline_title'|trans({}, 'chordslab') }}</strong>
            <p>{{ 'chordslab.no_timeline_body'|trans({}, 'chordslab') }}</p>
            <small>{{ 'chordslab.analyze.note'|trans({}, 'chordslab') }}</small>
        </div>
    {% endif %}
</section>

{% if playback_ready %}
<section class="panel stem-mixer-panel chordslab-player"
         data-stem-mixer
         data-mix-save-url="{{ path('app_song_stems_mix', {'_locale': app.request.locale, id: song.id}) }}"
         data-mix-token="{{ csrf_token('song_stems_mix_' ~ song.id) }}"
         data-mix-settings="{{ stem_mix_settings|json_encode|e('html_attr') }}"
         data-i18n-saved="{{ 'stems.mixer.saved'|trans({}, 'stems') }}"
         data-i18n-modified="{{ 'stems.mixer.modified'|trans({}, 'stems') }}"
         data-i18n-saving="{{ 'stems.mixer.saving'|trans({}, 'stems') }}"
         data-i18n-save-failed="{{ 'stems.mixer.save_failed'|trans({}, 'stems') }}"
         data-i18n-ready="{{ 'stems.mixer.ready'|trans({}, 'stems') }}"
         data-i18n-playing="{{ 'stems.mixer.playing'|trans({}, 'stems') }}"
         data-i18n-paused="{{ 'stems.mixer.paused'|trans({}, 'stems') }}"
         data-i18n-finished="{{ 'stems.mixer.finished'|trans({}, 'stems') }}"
         data-i18n-audio-error-template="{{ 'stems.mixer.audio_error'|trans({'%error%':'__ERROR__'}, 'stems') }}">

    <div class="chordslab-transport">
        <button type="button" data-mixer-play>{{ 'stems.mixer.play'|trans({}, 'stems') }}</button>
        <button type="button" data-mixer-pause>{{ 'stems.mixer.pause'|trans({}, 'stems') }}</button>
        <button type="button" data-mixer-stop>{{ 'stems.mixer.stop'|trans({}, 'stems') }}</button>
        <label class="chordslab-quick-volume">
            <span>Volume</span>
            <input type="range" min="0" max="1.25" step="0.01" value="1" data-chordslab-quick-volume>
            <output data-chordslab-quick-volume-output>100%</output>
        </label>
        <input type="range" min="0" max="1000" value="0" data-mixer-seek aria-label="Seek">
        <span data-mixer-time>0:00 / 0:00</span>
        <select data-mixer-rate aria-label="{{ 'stems.mixer.speed'|trans({}, 'stems') }}">
            {% for rate in [0.75, 0.9, 1, 1.1, 1.25] %}
                <option value="{{ rate }}" {{ rate == 1 ? 'selected' : '' }}>{{ rate }}×</option>
            {% endfor %}
        </select>
        <span class="stem-mixer-state" data-mixer-state>{{ 'stems.mixer.ready'|trans({}, 'stems') }}</span>
        <label class="chordslab-wakelock">
            <input type="checkbox" data-chordslab-wakelock checked>
            <span>{{ 'chordslab.keep_awake'|trans({}, 'chordslab') }}</span>
        </label>
    </div>

    <details class="chordslab-collapse">
        <summary>{{ 'chordslab.tracks'|trans({}, 'chordslab') }}</summary>
        <div class="stem-mixer-tracks">
            {% set mix_tracks = [
                {'key':'original', 'label':('stems.mixer.original'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'original'}), 'enabled':1, 'volume':1.00},
                {'key':'lead_vocals', 'label':('stems.name.lead_vocals'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'lead_vocals'}), 'enabled':0, 'volume':0.82},
                {'key':'backing_vocals', 'label':('stems.name.backing_vocals'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'backing_vocals'}), 'enabled':0, 'volume':0.72},
                {'key':'drums', 'label':('stems.name.drums'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'drums'}), 'enabled':0, 'volume':0.72},
                {'key':'bass', 'label':('stems.name.bass'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'bass'}), 'enabled':0, 'volume':0.72},
                {'key':'guitar', 'label':('stems.name.guitar'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'guitar'}), 'enabled':0, 'volume':0.72},
                {'key':'piano', 'label':('stems.name.piano'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'piano'}), 'enabled':0, 'volume':0.72},
                {'key':'other', 'label':('stems.name.other'|trans({}, 'stems')), 'url': path('app_song_stems_playback_audio', {'_locale': app.request.locale, id: song.id, name:'other'}), 'enabled':0, 'volume':0.72}
            ] %}

            {% for track in mix_tracks %}
                <div class="stem-mixer-grid stem-mixer-row"
                     data-mixer-track
                     data-track-key="{{ track.key }}"
                     data-track-url="{{ track.url }}">
                    <div class="stem-track-title">
                        <strong>{{ track.label }}</strong>
                        <span class="stem-track-loader" data-track-loader hidden></span>
                        <small class="stem-track-load-status" data-track-load-status></small>
                    </div>
                    <label class="stem-mixer-toggle">
                        <input type="checkbox" data-track-enabled {{ track.enabled ? 'checked' : '' }}>
                        <span>{{ 'stems.mixer.active'|trans({}, 'stems') }}</span>
                    </label>
                    <label class="stem-mixer-slider">
                        <input type="range" min="0" max="1.25" step="0.01" value="{{ track.volume }}" data-track-volume>
                        <output data-track-volume-output>{{ (track.volume * 100)|round }}%</output>
                    </label>
                </div>
            {% endfor %}
        </div>
    </details>

    <details class="chordslab-collapse">
        <summary>{{ 'chordslab.master_fx'|trans({}, 'chordslab') }}</summary>
        <div class="stem-master-fx chordslab-master-fx">
            <div class="stem-master-fx-grid">
                <label class="stem-master-control"><span>{{ 'stems.mixer.low'|trans({}, 'stems') }}</span><input type="range" min="-12" max="12" step="0.5" value="0" data-master-low><output data-master-low-output>0 dB</output></label>
                <label class="stem-master-control"><span>{{ 'stems.mixer.mid'|trans({}, 'stems') }}</span><input type="range" min="-12" max="12" step="0.5" value="0" data-master-mid><output data-master-mid-output>0 dB</output></label>
                <label class="stem-master-control"><span>{{ 'stems.mixer.high'|trans({}, 'stems') }}</span><input type="range" min="-12" max="12" step="0.5" value="0" data-master-high><output data-master-high-output>0 dB</output></label>
                <label class="stem-master-control"><span>{{ 'stems.mixer.compression'|trans({}, 'stems') }}</span><input type="range" min="0" max="100" step="1" value="0" data-master-compression><output data-master-compression-output>0%</output></label>
                <label class="stem-master-control"><span>{{ 'stems.mixer.master'|trans({}, 'stems') }}</span><input type="range" min="0" max="1.25" step="0.01" value="1" data-master-volume><output data-master-volume-output>100%</output></label>
                <button type="button" data-master-fx-reset>{{ 'stems.mixer.reset'|trans({}, 'stems') }}</button>
            </div>
            <span class="stem-mix-save-state" data-mix-save-state>{{ 'stems.mixer.saved'|trans({}, 'stems') }}</span>
        </div>
    </details>
</section>
{% else %}
<section class="panel chordslab-player-missing">
    <strong>{{ 'chordslab.player_unavailable'|trans({}, 'chordslab') }}</strong>
    <p>{{ 'chordslab.player_unavailable_body'|trans({}, 'chordslab') }}</p>
    <a href="{{ path('app_song_stems', {'_locale': app.request.locale, id: song.id}) }}">StemsLab</a>
</section>
{% endif %}


<dialog class="ez-modal chord-analyze-dialog" data-chord-analyze-dialog>
    <div class="ez-modal-card">
        <h3>Réanalyser les accords ?</h3>
        <p>Une nouvelle analyse harmonique va être lancée dans le Worker et recalculera les trois profils Débutant, Intermédiaire et Expert.</p>
        <p>La nouvelle analyse remplacera la grille automatique actuelle. Les corrections manuelles de l’ancienne analyse seront supprimées.</p>
        <div class="ez-modal-actions">
            <button type="button" data-chord-analyze-cancel>Annuler</button>
            <button type="button" class="primary" data-chord-analyze-confirm>Lancer la réanalyse</button>
        </div>
    </div>
</dialog>



{% endblock %}

{% block javascripts %}
<script src="/assets/js/lab-song-card.js?v=20260928r38_8"></script>
<script src="/assets/js/audio/ezscore-audio-engine.js?v=20260928r35_8"></script>
<script src="/assets/js/stems-mixer.js?v=20260929r39_2a"></script>
<script src="/assets/js/ezscore-timeline-core-r39.js?v=20260929r39_0"></script>
<script src="/assets/js/components/ezscore-live-visual-settings.js?v=20260930r39_2d"></script>
<script src="/assets/js/chordslab.js?v=20260929r39_0"></script>
<script src="/assets/js/chordslab-r33-2.js?v=20260928r35_10"></script>
<script src="/assets/js/chordslab-r33-1.js?v=20260927r34_6"></script>
{% endblock %}
