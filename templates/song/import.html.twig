{% extends 'base.html.twig' %}
{% block title %}{{ 'catalog.import.heading'|trans }} — EZScore_v1{% endblock %}
{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/workflow-tabs-r23-2.css?v=20260925r23_2"><link rel="stylesheet" href="/assets/css/catalog.css?v=20260925r23_2"><link rel="stylesheet" href="/assets/css/song-import-preview.css?v=20260925r21">{% endblock %}
{% block body %}
{% include 'layout/song/_workflow_tabs.html.twig' with {current:'import'} %}

<header class="page-head">
    <div>
        <div class="eyebrow">{{ 'catalog.import.eyebrow'|trans }}</div>
        <h1>{{ 'catalog.import.heading'|trans }}</h1>
        <p class="page-note">{{ 'catalog.import.lead'|trans }}</p>
    </div>
</header>

{% if duplicate_song is defined and duplicate_song %}<div class="flash flash-error"><strong>Doublon probable :</strong> {{ duplicate_song.artist }} — {{ duplicate_song.title }} (#{{ duplicate_song.id }}). Rechargez le fichier et confirmez seulement s’il s’agit d’une autre version.</div>{% endif %}
<form method="post" enctype="multipart/form-data" class="song-import-form">
    <input type="hidden" name="_token" value="{{ csrf_token('song_import') }}">

    <section class="panel import-source-panel">
        <h2>{{ 'catalog.import.source_heading'|trans }}</h2>
        <label class="audio-import-field">
            <span>{{ 'catalog.import.audio_label'|trans }}</span>
            <input id="song-audio-input"
                   type="file"
                   name="audio"
                   accept=".mp3,.wav,.flac,.m4a,.ogg,.aac,audio/*"
                   required
                   data-audio-input>
            <small>{{ 'catalog.import.audio_help'|trans }}</small>
            <small class="upload-limit-note">{{ 'catalog.import.php_limit_note'|trans }}</small>
        </label>

        <div class="audio-preview" data-audio-preview hidden>
            <div class="audio-preview-head">
                <strong>{{ 'catalog.import.preview.heading'|trans }}</strong>
                <span data-audio-preview-name></span>
            </div>
            <audio controls preload="metadata" data-audio-player></audio>
            <small>{{ 'catalog.import.preview.help'|trans }}</small>
        </div>
    </section>

    {% include 'layout/song/_card.html.twig' with {
        mode: 'import',
        editors: editors,
        current_editor: current_editor,
        status_choices: status_choices
    } %}

    <div class="song-import-actions">
        <a class="ez-back-link" href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">{{ 'common.cancel'|trans }}</a>
        <button class="primary" type="submit">{{ 'catalog.import.submit'|trans }}</button>
    </div>
{% if duplicate_song is defined and duplicate_song %}<label><input type="checkbox" name="confirm_duplicate" value="1" required> Je confirme qu’il s’agit d’une autre version/interprétation.</label>{% endif %}</form>
{% endblock %}
{% block javascripts %}<script src="/assets/js/song-import.js?v=20260925r21"></script>{% endblock %}
