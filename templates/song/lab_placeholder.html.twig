{% extends 'base.html.twig' %}

{% set meta = {
    'analysis': {
        'title': 'labs.analysis.title'|trans({'%title%': song.title}, 'labs'),
        'eyebrow': 'labs.analysis.eyebrow'|trans({}, 'labs'),
        'body': 'labs.analysis.body'|trans({}, 'labs')
    },
    'chords': {
        'title': 'labs.chords.title'|trans({'%title%': song.title}, 'labs'),
        'eyebrow': 'labs.chords.eyebrow'|trans({}, 'labs'),
        'body': 'labs.chords.body'|trans({}, 'labs')
    },
    'lyrics': {
        'title': 'labs.lyrics.title'|trans({'%title%': song.title}, 'labs'),
        'eyebrow': 'labs.lyrics.eyebrow'|trans({}, 'labs'),
        'body': 'labs.lyrics.body'|trans({}, 'labs')
    },
    'publication': {
        'title': 'labs.publication.title'|trans({'%title%': song.title}, 'labs'),
        'eyebrow': 'labs.publication.eyebrow'|trans({}, 'labs'),
        'body': 'labs.publication.body'|trans({}, 'labs')
    }
}[lab] %}

{% block title %}{{ meta.title }} — EZScore_v1{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/workflow-tabs-r23-2.css?v=20260926r31">
<link rel="stylesheet" href="/assets/css/catalog.css?v=20260925r23_2">
{% endblock %}

{% block body %}
{% include 'layout/song/_workflow_tabs.html.twig' with {current:lab, song:song} %}

<header class="page-head">
    <div>
        <div class="eyebrow">{{ meta.eyebrow }}</div>
        <h1>{{ meta.title }}</h1>
        <p class="page-note">{{ meta.body }}</p>
    </div>
    <a href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">
        Répertoire
    </a>
</header>

<section class="panel lab-shell-card">
    <div class="eyebrow">{{ 'labs.shell.eyebrow'|trans({}, 'labs') }}</div>
    <h2>{{ 'labs.shell.title'|trans({}, 'labs') }}</h2>
    <p>{{ 'labs.shell.body'|trans({}, 'labs') }}</p>

    {% if lab == 'chords' %}
        <div class="lab-shell-preview" aria-label="{{ 'labs.chords.preview_aria'|trans({}, 'labs') }}">
            <div class="lab-shell-toolbar">
                <span>Capo 0</span>
                <span>4/4</span>
                <span>{{ 'labs.chords.level_intermediate'|trans({}, 'labs') }}</span>
            </div>
            <div class="lab-shell-prompt">
                <span>[ Em--- ]</span>
                <span>[ Am-A. ]</span>
                <span>[ C--- ]</span>
                <span>[ G-D- ]</span>
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
