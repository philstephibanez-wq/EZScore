{% extends 'base.html.twig' %}
{% block title %}{{ song.title }} — EZScore_v1{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/workflow-tabs-r23-2.css?v=20260925r23_2">
<link rel="stylesheet" href="/assets/css/catalog.css?v=20260925r23_2">
{% endblock %}

{% block body %}
<div class="workspace" data-can-edit="{{ can_edit ? '1' : '0' }}">
    {% if can_edit %}
        {% include 'layout/song/_workflow_tabs.html.twig' with {current:'', song:song} %}
    {% endif %}

{% include 'layout/song/_card.html.twig' with {mode:'display', song:song, rating_summary:rating_summary, user_rating:user_rating, show_internal_comment:can_edit} %}

    <section class="song-access-bar">
        <div>
            <span class="song-status-badge status-{{ song.status.value }}">{{ ('song.status.' ~ song.status.value)|trans }}</span>

            {% if karaoke_preview_seconds > 0 %}
                <span class="access-chip preview">{{ 'workspace.access.preview'|trans({'%seconds%': karaoke_preview_seconds}) }}</span>
            {% elseif can_use_karaoke %}
                <span class="access-chip">{{ 'workspace.access.karaoke_full'|trans }}</span>
            {% endif %}

            {% if can_play_audio %}
                <span class="access-chip">{{ 'workspace.access.audio_full'|trans }}</span>
            {% endif %}
        </div>

        <div class="song-workspace-actions">
            {% if can_edit %}
                <form method="post" enctype="multipart/form-data" action="{{ path('app_song_reimport', {'_locale': app.request.locale, id: song.id}) }}" onsubmit="return confirm('ATTENTION : la réimportation remplace l’audio source et invalide stems, accords, paroles, alignements et artefacts dérivés. Continuer ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('song_reimport_' ~ song.id) }}">
                    <input type="file" name="audio" accept=".mp3,.wav,.ogg,.m4a,.flac,audio/*" required>
                    <button type="submit" class="danger-button">Réimporter</button>
                </form>
            {% endif %}
            {% if can_publish %}
                <form method="post" action="{{ path('app_song_publication', {'_locale': app.request.locale, id: song.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('song_publication_' ~ song.id) }}">

                    {% if song.status.value != 'imported' %}
                        <button type="submit"
                                name="action"
                                value="imported"
                                class="status-reset-button"
                                onclick="return confirm('{{ 'catalog_admin.reset_imported_confirm'|trans({}, 'admin_catalog')|e('js') }}')">
                            {{ 'catalog_admin.reset_imported_action'|trans({}, 'admin_catalog') }}
                        </button>
                    {% endif %}

                    {% if song.published %}
                        <button type="submit" name="action" value="unpublish">{{ 'song.publication.unpublish'|trans }}</button>
                    {% else %}
                        <button class="primary" type="submit" name="action" value="publish">{{ 'song.publication.publish'|trans }}</button>
                    {% endif %}
                </form>
            {% endif %}
        </div>
    </section>

    {% if not app.user %}
        <section class="panel public-song-gate">
            <div>
                <div class="eyebrow">{{ 'workspace.public_gate.eyebrow'|trans }}</div>
                <h2>{{ 'workspace.public_gate.heading'|trans }}</h2>
                <p>{{ 'workspace.public_gate.body'|trans({'%seconds%': karaoke_preview_seconds}) }}</p>
            </div>
            <div class="catalog-hero-actions">
                <a class="catalog-cta primary-cta" href="{{ path('app_register', {'_locale': app.request.locale}) }}">{{ 'catalog.public.register'|trans }}</a>
                <a class="catalog-cta secondary-cta" href="{{ path('app_login', {'_locale': app.request.locale}) }}">{{ 'auth.login.submit'|trans }}</a>
            </div>
        </section>
    {% endif %}

    {% if can_edit %}
    <section class="panel source-truth-panel">
        <h2>{{ 'stems.workspace.heading'|trans({}, 'stems') }}</h2>
        <p>{{ 'stems.workspace.body'|trans({}, 'stems') }}</p>
        <a class="primary" href="{{ path('app_song_stems', {'_locale': app.request.locale, id: song.id}) }}">{{ 'stems.workspace.open'|trans({}, 'stems') }}</a>
    </section>
    {% endif %}
</div>
{% endblock %}
