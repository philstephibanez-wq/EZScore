{# R39.2D — shared realtime visual settings for Chords/Lyrics/Karaoke-ready use. #}
{% set signatures = time_signatures|default(['2/4','3/4','4/4','6/8']) %}
<section class="panel ez-live-settings" data-ez-live-settings data-ez-live-settings-context="{{ context|default('editor') }}">
    <form method="post"
          action="{{ path('app_song_chordslab_settings', {'_locale': app.request.locale, id: song.id}) }}"
          class="ez-live-settings-grid"
          data-chord-settings-form>
        <input type="hidden" name="_token" value="{{ csrf_token('song_chordslab_settings_' ~ song.id) }}">

        <label class="ez-live-setting ez-live-setting-capo">
            <span>Capo</span>
            <select name="capo" data-chordslab-capo>
                {% for value in 0..11 %}
                    <option value="{{ value }}" {{ song.capo == value ? 'selected' : '' }}>{{ value }}</option>
                {% endfor %}
            </select>
        </label>

        <label class="ez-live-setting ez-live-setting-signature">
            <span>Signature</span>
            <select name="time_signature" data-chordslab-timesig>
                {% for signature in signatures %}
                    <option value="{{ signature }}" {{ song.timeSignature == signature ? 'selected' : '' }}>{{ signature }}</option>
                {% endfor %}
            </select>
        </label>

        <label class="ez-live-setting ez-live-setting-profile">
            <span>Niveau d’analyse</span>
            <select name="chord_analysis_level" data-chordslab-profile>
                {% for level in ['beginner','intermediate','expert'] %}
                    <option value="{{ level }}" {{ song.chordAnalysisLevel == level ? 'selected' : '' }}>
                        {{ ('chordslab.level.' ~ level)|trans({}, 'chordslab') }}
                    </option>
                {% endfor %}
            </select>
        </label>

        <label class="ez-live-setting-toggle">
            <input type="checkbox" data-chordslab-diagram checked>
            <span>{{ 'chordslab.guitar_chords'|trans({}, 'chordslab') }}</span>
        </label>

        <small class="ez-live-settings-help" data-analysis-level-help></small>

        <div class="ez-live-settings-state">
            <span data-chord-settings-state>Enregistré automatiquement</span>
            <small>{{ 'chordslab.level_note'|trans({}, 'chordslab') }}</small>
        </div>
    </form>
</section>
