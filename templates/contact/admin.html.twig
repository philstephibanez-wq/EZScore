{% extends 'base.html.twig' %}
{% block title %}Contacter l’administrateur — EZScore{% endblock %}
{% block body %}<section class="panel" style="max-width:760px;margin:2rem auto"><h1>Contacter l’administrateur</h1><p>Votre message est transmis par EZScore. L’adresse de l’administrateur n’est pas affichée.</p>{% if song %}<p><strong>Chanson :</strong> {{ song.artist }} — {{ song.title }}</p>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('contact_admin') }}"><input type="hidden" name="song_id" value="{{ song ? song.id : 0 }}"><label>Catégorie<select name="category"><option>Bug</option><option>Question</option><option>Demande d’accès</option><option>Problème de chanson</option><option>Autre</option></select></label><label>Sujet<input name="subject" maxlength="180" required></label><label>Message<textarea name="message" rows="10" maxlength="10000" required></textarea></label><button type="submit">Envoyer</button></form></section>{% endblock %}
