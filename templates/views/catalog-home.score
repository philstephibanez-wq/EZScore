<style>
.ez-catalog-home-title{display:flex;align-items:center;gap:.55rem;margin:.15rem 0 .55rem 0}
.ez-catalog-home-title h2{margin:0;font-size:1.45rem}
.ez-catalog-letter{margin:.95rem 0 .35rem 0;padding:.2rem .45rem;border-bottom:1px solid rgba(128,128,128,.22);font-size:1.1rem;font-weight:800}
.ez-catalog-song-title{font-weight:800;line-height:1.15}
.ez-catalog-status{display:inline-block;margin-top:.2rem;padding:.08rem .38rem;border-radius:.45rem;font-size:.72rem;border:1px solid rgba(128,128,128,.25)}
.ez-catalog-status.published{border-color:rgba(54,179,126,.48)}
.ez-catalog-status.validated{border-color:rgba(81,144,255,.48)}
.ez-catalog-status.working{border-color:rgba(255,183,77,.45)}
.ez-catalog-status.pending{opacity:.72}
.ez-catalog-meta{margin-top:.18rem;font-size:.73rem;opacity:.72}
.ez-catalog-note{margin-top:.1rem;font-size:.73rem;opacity:.82}
.ez-rating{white-space:nowrap;line-height:1.05}
.ez-rating-stars{letter-spacing:.02rem;font-size:.94rem}
.ez-rating-meta{font-size:.68rem;opacity:.72;margin-top:.08rem}
.ez-playlist-title{display:flex;align-items:baseline;gap:.5rem;margin:.85rem 0 .2rem 0}
.ez-playlist-title strong{font-size:1.08rem}
.ez-playlist-count{font-size:.73rem;opacity:.68}
.ez-playlist-song-title{font-weight:750;line-height:1.05}
.ez-playlist-song-artist{font-size:.72rem;opacity:.7;margin-top:.08rem}
</style>
<div class="ez-catalog-home-title"><span>🎵</span><h2>{{ title }}</h2></div>
