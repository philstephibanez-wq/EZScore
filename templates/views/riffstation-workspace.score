<div class="ez-riff-root">
  <nav class="workflow-tabs" aria-label="Workflow Analyse">
    <button class="step-tab step-tab-1" type="button" data-step="1">1 · STEMS</button>
    <button class="step-tab step-tab-2" type="button" data-step="2">2 · PAROLES</button>
  </nav>
  <section class="song-cartouche">
    <div class="song-summary">
      <div class="summary-item summary-wide"><span class="k">Titre</span><strong class="summary-title">—</strong></div>
      <div class="summary-item summary-wide"><span class="k">Auteur / Interprète</span><strong class="summary-artist">—</strong></div>
      <div class="summary-item"><span class="k">Éditeur</span><strong class="summary-editor">—</strong></div>
      <div class="summary-item"><span class="k">Time sig</span><strong class="summary-signature">—</strong></div>
      <div class="summary-item"><span class="k">Capo</span><strong class="summary-capo">—</strong></div>
      <div class="summary-item summary-wide"><span class="k">Strumming</span><strong class="summary-strum">—</strong></div>
    </div>

    <details class="editor-details">
      <summary>📝 Formulaire morceau</summary>
      <div class="editor-form">
        <div class="meta-row meta-row-primary">
          <label>Titre<input class="edit-title" type="text"></label>
          <label>Auteur / Interprète<input class="edit-artist" type="text"></label>
          <label class="editor-select-wrap">Éditeur assigné<select class="edit-editor"></select></label>
        </div>
        <div class="meta-row meta-row-secondary">
          <label>Time signature<select class="edit-signature"></select></label>
          <label>Capodastre<select class="edit-capo"></select></label>
          <label>Strumming principal<input class="edit-strum" type="text" placeholder="ex. ↓ ↓↑ ↑↓↑"></label>
          <label>Strumming alternatif<input class="edit-strum-alt" type="text" placeholder="ex. refrain : ↓↑ ↓↑ ↓↑ ↓↑"></label>
        </div>
        <div class="meta-actions"><button class="save-header" type="button">💾 Enregistrer</button></div>
      </div>
    </details>
  </section>

  <details class="mixer-details" open>
    <summary>🎚️ STEMS + table de mixage</summary>
    <div class="mixer-body">
      <div class="mixer-head"><div>Piste</div><div>ON</div><div>Volume</div><div>Graves</div><div>Médiums</div><div>Aigus</div><div></div></div>
      <div class="tracks"></div>
      <div class="master-row"><div class="master-name">Master</div><div class="master-value">100%</div><input class="master-volume" type="range" min="0" max="1.25" step="0.01" value="1"></div>
    </div>
  </details>

  <details class="player-details" open>
    <summary>▶ Player</summary>
    <div class="player-body">
      <div class="player-tools"><label class="diagram-toggle"><input class="show-diagrams" type="checkbox"> Diagramme accord courant</label><span class="mode-badge"></span></div>

      <div class="conductor-stage">
        <div class="fixed-playhead" aria-hidden="true"></div>
        <div class="diagram-anchor"><div class="current-diagram"></div></div>
        <div class="current-chord-anchor"><span class="current-chord-label"></span></div>
        <div class="timeline-window chord-window"><div class="chord-track"></div></div>
        <div class="timeline-window lyric-window"><div class="lyric-track"></div></div>
      </div>

      <input class="seek" type="range" min="0" max="1" step="0.001" value="0">
      <div class="transport">
        <button class="play" type="button">▶ Lecture</button>
        <button class="pause" type="button">⏸ Pause</button>
        <button class="stop" type="button">⏹ Stop</button>
        <label>Vitesse<select class="playback-rate"><option value="0.50">0,50×</option><option value="0.60">0,60×</option><option value="0.70">0,70×</option><option value="0.75">0,75×</option><option value="0.85">0,85×</option><option value="1.00" selected>1,00×</option><option value="1.10">1,10×</option><option value="1.25">1,25×</option><option value="1.50">1,50×</option></select></label>
        <span class="time">0:00 / 0:00</span>
      </div>
    </div>
  </details>

  <div class="hint">Timeline audio immuable · beats réguliers · diagramme, accord courant et mot courant sur la même mire.</div>
</div>
