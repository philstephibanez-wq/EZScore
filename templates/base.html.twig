<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="application-name" content="EZScore V1.0">
    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon-ezscore.svg?v=20261006final">
    <title>{% block title %}EZScore V1.0{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/base.css?v=20260924">
    <link rel="stylesheet" href="/assets/css/layout.css?v=20261006final">
    <link rel="stylesheet" href="/assets/css/workflow-tabs-r23-2.css?v=20260926r32_3">
    {% block stylesheets %}{% endblock %}
    <link rel="stylesheet" href="/assets/css/cast/ezscore-cast.css?v=20261002r1">
    <link rel="stylesheet" href="/assets/css/concert-sync-r1.css?v=20261002r1">
<link rel="stylesheet" href="/assets/css/live/live-notification-r1c1.css?v=20261002r1c1">
    <link rel="stylesheet" href="/assets/css/interactions.css?v=20260924f">
    <link rel="stylesheet" href="/assets/css/ez-modal.css?v=20260928r35_7">
    <link rel="stylesheet" href="/assets/css/r21-admin.css?v=20260925r21">
    <link rel="stylesheet" href="/assets/css/r35-4a-contact-header.css?v=20260927r35_4a">
    <link rel="stylesheet" href="/assets/css/r35-5-ux.css?v=20260927r35_5">
    {% if app.user and is_granted('ROLE_EDITOR') %}
        <link rel="stylesheet" href="/assets/css/analysis-worker-status.css?v=20260926r24_16">
    {% endif %}
</head>
<body>
{% set public_catalog = not app.user and app.request.attributes.get('_route') == 'app_catalog' %}

{% macro flag(locale) %}
    {% if locale == 'fr' %}
        <svg class="ez-flag" viewBox="0 0 3 2" aria-hidden="true" focusable="false">
            <rect width="1" height="2" x="0" fill="#0055A4"/><rect width="1" height="2" x="1" fill="#FFFFFF"/><rect width="1" height="2" x="2" fill="#EF4135"/>
        </svg>
    {% else %}
        <svg class="ez-flag" viewBox="0 0 60 36" aria-hidden="true" focusable="false">
            <rect width="60" height="36" fill="#012169"/><path d="M0 0 60 36M60 0 0 36" stroke="#fff" stroke-width="8"/><path d="M0 0 60 36M60 0 0 36" stroke="#C8102E" stroke-width="4"/><path d="M30 0v36M0 18h60" stroke="#fff" stroke-width="12"/><path d="M30 0v36M0 18h60" stroke="#C8102E" stroke-width="7"/>
        </svg>
    {% endif %}
{% endmacro %}

{% macro language_select() %}
    {% import _self as self %}
    <form class="ez-language-form" method="post" action="{{ path('app_locale', {locale: app.request.locale}) }}" data-language-form>
        <input type="hidden" name="_token" value="{{ csrf_token('locale') }}">
        <div class="ez-language-listbox" data-language-listbox>
            <button type="button" class="ez-language-trigger" aria-haspopup="listbox" aria-expanded="false" data-language-trigger>
                {{ self.flag(app.request.locale) }}
                <span>{{ app.request.locale == 'fr' ? ('locale.fr_name'|trans) : ('locale.en_name'|trans) }}</span>
                <span class="ez-language-chevron" aria-hidden="true">âŒ„</span>
            </button>
            <div class="ez-language-menu" role="listbox" aria-label="{{ 'locale.label'|trans }}" data-language-menu hidden>
                <button type="button" class="ez-language-option {{ app.request.locale == 'fr' ? 'active' : '' }}" role="option" aria-selected="{{ app.request.locale == 'fr' ? 'true' : 'false' }}" data-language-option="fr">{{ self.flag('fr') }}<span>{{ 'locale.fr_name'|trans }}</span></button>
                <button type="button" class="ez-language-option {{ app.request.locale == 'en' ? 'active' : '' }}" role="option" aria-selected="{{ app.request.locale == 'en' ? 'true' : 'false' }}" data-language-option="en">{{ self.flag('en') }}<span>{{ 'locale.en_name'|trans }}</span></button>
            </div>
        </div>
    </form>
{% endmacro %}

{% import _self as ui %}

{% if app.user %}
<div class="ez-shell" data-ez-shell>
    <header class="ez-topbar">
        <div class="ez-topbar-left">
            <button type="button" class="ez-menu-button" data-ez-menu-button aria-controls="ez-drawer" aria-expanded="false" aria-label="{{ 'layout.sidebar.toggle'|trans }}" title="{{ 'layout.sidebar.toggle'|trans }}"><span aria-hidden="true"></span></button>
            <a class="ez-brand" href="{{ path('app_catalog', {'_locale': app.request.locale}) }}" aria-label="EZScore V1.0">
                <img class="ez-brand-icon" src="/assets/img/favicon-ezscore.svg?v=20261006final" alt="" aria-hidden="true">
                <strong>EZScore</strong><small>V1.0</small>
            </a>
            {% if app.request.server.get('EZSCORE_INSTANCE') == 'dev' %}
                <span class="ez-dev-badge" role="status" aria-label="Environnement de développement">DEV</span>
            {% endif %}
        </div>
        <div class="ez-search-slot">
            <form class="ez-search-form" method="get" action="{{ path('app_catalog', {'_locale': app.request.locale}) }}" role="search">
                <label class="sr-only" for="ez-global-search">{{ 'layout.search.label'|trans }}</label>
                <input id="ez-global-search" name="q" type="search" value="{{ app.request.query.get('q') }}" placeholder="{{ 'layout.search.placeholder'|trans }}" autocomplete="off">
                <button type="submit" aria-label="{{ 'layout.search.submit'|trans }}" title="{{ 'layout.search.submit'|trans }}"><span aria-hidden="true"></span></button>
            </form>
        </div>
        <div class="ez-topbar-right">
            <a class="ez-concert-link" href="{{ path('app_events', {'_locale': app.request.locale}) }}" title="Sessions" aria-label="Sessions">Session</a>
            {{ ui.language_select() }}
            <a class="ez-contact-admin-link" href="{{ path('app_contact_admin', {'_locale': app.request.locale}) }}" title="Contacter lâ€™administrateur" aria-label="Contacter lâ€™administrateur">âœ‰ <span>Contacter lâ€™admin</span></a>
            <a class="ez-user-badge" href="{{ path('app_profile', {'_locale': app.request.locale}) }}" title="{{ app.user.email }}">
                {% if app.user.avatarUrl %}<img src="{{ app.user.avatarUrl }}" alt="">{% else %}<span class="ez-user-avatar">{{ app.user.displayName|slice(0, 1)|upper }}</span>{% endif %}
                <span class="ez-user-copy"><strong>{{ app.user.displayName }}</strong><small>{{ ('role.' ~ app.user.primaryRole)|trans }}</small></span>
            </a>
        </div>
    </header>

    {% if is_granted('ROLE_EDITOR') %}
        <div class="analysis-worker-banner"
             data-analysis-worker-banner
             data-status-url="{{ path('app_analysis_worker_status') }}"
             role="status"
             hidden>
            <span class="analysis-worker-banner-dot" aria-hidden="true"></span>
            <strong>{{ 'analysis_worker.offline.title'|trans }}</strong>
            <span>{{ 'analysis_worker.offline.body'|trans }}</span>
        </div>
    {% endif %}

    <button type="button" class="ez-drawer-backdrop" data-ez-drawer-backdrop aria-hidden="true" tabindex="-1"></button>

    <aside class="ez-drawer" id="ez-drawer" data-ez-drawer aria-label="{{ 'layout.sidebar.navigation'|trans }}">
        <nav class="ez-drawer-nav">
            <a href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">{{ 'nav.catalog'|trans }}</a>
            <a href="{{ path('app_playlists', {'_locale': app.request.locale}) }}">{{ 'nav.playlists'|trans }}</a>
            <a href="{{ path('app_groups', {'_locale': app.request.locale}) }}">{{ 'nav.groups'|trans }}</a>
            <a href="{{ path('app_events', {'_locale': app.request.locale}) }}">{{ 'event.nav'|trans({}, 'event') }}</a>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="ez-nav-sep">{{ 'nav.administration'|trans }}</div>
                <a href="{{ path('admin_users', {'_locale': app.request.locale}) }}">{{ 'nav.users'|trans }}</a>
            {% endif %}
        </nav>
        <div class="ez-drawer-footer">
            <a class="ez-drawer-user ez-drawer-profile" href="{{ path('app_profile', {'_locale': app.request.locale}) }}">
                <strong>{{ app.user.displayName }}</strong>
                <small>{{ app.user.email }}</small>
                <span>{{ 'profile.nav'|trans({}, 'profile') }}</span>
            </a>
            <a class="ez-logout" href="{{ path('app_logout', {'_locale': app.request.locale}) }}">{{ 'nav.logout'|trans }}</a>
        </div>
    </aside>

    {% if is_granted('ROLE_DISPLAY') %}
    <div class="live-notification" data-live-notification data-live-status-url="{{ path('app_live_open') }}" hidden>
        <div class="live-notification-inner">
            <strong data-live-label>Session ouverte</strong>
            <span data-live-conductor></span>
            <a data-live-join href="#">Rejoindre</a>
        </div>
    </div>
    {% endif %}

    <main class="ez-main" id="main-content">
        {% if app.request.attributes.get('_route') not in ['app_catalog', 'app_dashboard'] %}
            <a class="ez-back-link" href="{{ path('app_catalog', {'_locale': app.request.locale}) }}">â† {{ 'nav.catalog'|trans }}</a>
        {% endif %}
{% else %}
<main class="{{ public_catalog ? 'public-shell' : 'auth-shell' }}">
    <div class="auth-topbar">
        <div class="ez-public-brand-wrap">
            <a class="ez-brand" href="{{ path('app_home') }}" aria-label="EZScore V1.0">
                <img class="ez-brand-icon" src="/assets/img/favicon-ezscore.svg?v=20261006final" alt="" aria-hidden="true">
                <strong>EZScore</strong><small>V1.0</small>
            </a>
            {% if app.request.server.get('EZSCORE_INSTANCE') == 'dev' %}
                <span class="ez-dev-badge" role="status" aria-label="Environnement de développement">DEV</span>
            {% endif %}
        </div>
        <div class="public-topbar-actions">
            {% if public_catalog %}
                {# R38.14a public contact header #}
                <a class="public-login-link" href="{{ path('app_public_contact', {'_locale': app.request.locale}) }}">{{ app.request.locale == 'en' ? 'Contact LogAndPlay' : 'Contacter LogAndPlay' }}</a>
                <a class="public-login-link" href="{{ path('app_login', {'_locale': app.request.locale}) }}">{{ 'auth.login.submit'|trans }}</a>
                <span class="public-register-link registration-disabled" aria-disabled="true">{{ app.request.locale == 'en' ? 'Registrations coming soon' : 'Inscriptions prochainement' }}</span>
            {% endif %}
            {{ ui.language_select() }}
        </div>
    </div>
{% endif %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
            {% if message starts with 'chordslab.analyze.failed|' %}
                {% set parts = message|split('|', 2) %}
                <div class="flash flash-{{ label }}">{{ 'chordslab.analyze.failed'|trans({'%error%': parts[1]|default('')}, 'chordslab') }}</div>
            {% else %}
                <div class="flash flash-{{ label }}">{{ message starts with 'event.' ? message|trans({}, 'event') : (message starts with 'chordslab.' ? message|trans({}, 'chordslab') : message|trans) }}</div>
            {% endif %}
        {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

{% if app.user %}</div>{% endif %}
<div class="ez-modal-backdrop" data-ez-confirm-modal hidden>
<section class="ez-modal" role="dialog" aria-modal="true" aria-labelledby="ez-confirm-title">
<div class="ez-modal-icon" aria-hidden="true">!</div>
<div class="ez-modal-copy"><div class="eyebrow">Confirmation</div><h2 id="ez-confirm-title">Confirmer lâ€™action</h2><p data-ez-confirm-message></p></div>
<div class="ez-modal-actions"><button type="button" data-ez-confirm-cancel>Annuler</button><button type="button" class="danger-soft" data-ez-confirm-ok>Confirmer</button></div>
</section></div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="/assets/js/cast/ezscore-cast.js?v=20261002r1"></script>
<script src="/assets/js/cast/ezscore-cast-native-bridge.js?v=20261002r1"></script>
<script src="/assets/js/cast/ezscore-cast-ui.js?v=20261002r1"></script>
<script src="/assets/js/app.js?v=20260924f"></script>
{% if app.user and is_granted('ROLE_DISPLAY') %}<script src="/assets/js/live/live-notification-r1c1.js?v=20261002r1c1"></script>{% endif %}
<script src="/assets/js/dirty-tracker.js?v=20260924"></script>
<script src="/assets/js/ez-modal.js?v=20260928r35_7"></script>
{% if app.user and is_granted('ROLE_EDITOR') %}
<script src="/assets/js/analysis-worker-status.js?v=20260926r24_16"></script>
<script src="/assets/js/audio/ezscore-audio-engine.js?v=20261001r41_0k5c"></script>
<script src="/assets/js/audio/ezscore-audio-session.js?v=20261001r41_0k5c"></script>
<script src="/assets/js/song-workflow-ajax.js?v=20261001r41_0k5c"></script>
{% endif %}
<script>
(() => {
    document.querySelectorAll('[data-language-listbox]').forEach((listbox) => {
        const form=listbox.closest('[data-language-form]'),trigger=listbox.querySelector('[data-language-trigger]'),menu=listbox.querySelector('[data-language-menu]');
        if(!form||!trigger||!menu)return;
        const close=()=>{menu.hidden=true;trigger.setAttribute('aria-expanded','false');};
        trigger.addEventListener('click',()=>{const open=menu.hidden;document.querySelectorAll('[data-language-menu]').forEach((other)=>{if(other!==menu)other.hidden=true;});menu.hidden=!open;trigger.setAttribute('aria-expanded',open?'true':'false');});
        menu.querySelectorAll('[data-language-option]').forEach((option)=>{option.addEventListener('click',()=>{form.action='/locale/'+encodeURIComponent(option.dataset.languageOption);form.submit();});});
        document.addEventListener('click',(event)=>{if(!listbox.contains(event.target))close();});
        document.addEventListener('keydown',(event)=>{if(event.key==='Escape')close();});
    });
})();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
