<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=Edge" />
<title>EZScore Launcher</title>
<HTA:APPLICATION
  ID="ezscoreLauncher"
  APPLICATIONNAME="EZScore Launcher"
  BORDER="thin"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="normal"
/>
<style>
html,body{margin:0;padding:0;background:#121a20;color:#eef5f7;font:15px "Segoe UI",Arial,sans-serif}
.wrap{padding:26px 30px;width:620px}
.brand{font-size:30px;font-weight:700;letter-spacing:.2px}
.version{font-size:12px;color:#8ca0ab;margin-left:7px}
.sub{color:#93a7b2;margin:4px 0 26px}
#status{font-size:17px;font-weight:700;margin-bottom:11px}
.track{height:15px;background:#26343d;border-radius:10px;overflow:hidden}
#bar{height:100%;width:3%;background:#36b7a7;transition:width .25s ease}
#percent{text-align:right;color:#93a7b2;font-size:12px;margin-top:5px}
#detail{margin-top:20px;padding:14px;min-height:112px;border:1px solid #2d3d47;border-radius:9px;background:#080c0f;color:#c9f6d2;font:12px/1.5 Consolas,monospace;white-space:pre-wrap;overflow:auto}
.ready{color:#9fe5b0!important}.error{color:#ffabab!important}
.actions{margin-top:15px;text-align:right}
button{padding:8px 16px;background:#1b2a33;color:#fff;border:1px solid #3a4d59;border-radius:7px;cursor:pointer}
</style>
<script language="javascript">
var fso = new ActiveXObject("Scripting.FileSystemObject");
var shell = new ActiveXObject("WScript.Shell");
var path = location.pathname.replace(/\//g,"\\");
if (/^\\[A-Za-z]:/.test(path)) path = path.substring(1);
var root = fso.GetParentFolderName(path);
var statusFile = root + "\\var\\runtime\\launcher-status.json";
var backend = root + "\\scripts\\launch_ezscore_backend.ps1";
var lastDetail = "";

function setDetail(text) {
    if (!text || text === lastDetail) return;
    lastDetail = text;
    document.getElementById("detail").innerText = text;
}

function startBackend() {
    document.getElementById("status").innerText = "Démarrage…";
    setDetail(
        "Serveur local :\n" +
        "php -S 127.0.0.1:8501 -t " + root + "\\public\n\n" +
        "Site ouvert dans Chrome :\n" +
        "https://ezscore.logandplay.com/"
    );

    try { if (fso.FileExists(statusFile)) fso.DeleteFile(statusFile, true); } catch(e) {}

    var cmd = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + backend + '"';
    shell.Run(cmd, 0, false);

    window.setInterval(readStatus, 250);
}

function readStatus() {
    try {
        if (!fso.FileExists(statusFile)) return;

        var file = fso.OpenTextFile(statusFile, 1, false, -1);
        var text = file.ReadAll();
        file.Close();

        var data = JSON.parse(text);
        var pct = Math.max(0, Math.min(100, data.percent || 0));

        document.getElementById("status").innerText = data.message || "Démarrage…";
        document.getElementById("bar").style.width = pct + "%";
        document.getElementById("percent").innerText = pct + " %";
        setDetail(data.detail || data.stage || "");

        var status = document.getElementById("status");
        status.className = "";

        if (data.state === "ready") {
            status.className = "ready";
            document.getElementById("close").style.display = "inline-block";
            window.setTimeout(function(){ window.close(); }, 1800);
        } else if (data.state === "error") {
            status.className = "error";
            document.getElementById("close").style.display = "inline-block";
        }
    } catch(e) {
        // Status file is atomically replaced; retry on next tick.
    }
}
</script>
</head>
<body onload="window.resizeTo(700,465); window.moveTo((screen.availWidth-700)/2,(screen.availHeight-465)/2); startBackend();">
<div class="wrap">
  <div><span class="brand">EZScore</span><span class="version">v1</span></div>
  <div class="sub">Démarrage de l'environnement local</div>

  <div id="status">Ouverture du launcher…</div>

  <div class="track"><div id="bar"></div></div>
  <div id="percent">0 %</div>

  <div id="detail">Initialisation…</div>

  <div class="actions">
    <button id="close" style="display:none" onclick="window.close()">Fermer</button>
  </div>
</div>
</body>
</html>
